<UserControl x:Class="JunqiStudio.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,24" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="设置" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,24" Text="一般不需要改。保存在程序目录下的 settings.json。"/>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="项目目录（junqi-ai）" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
          <TextBox x:Name="ProjectBox"/>
          <TextBlock Text="训练用 Python（PyTorch + ROCm 环境里的 python.exe）" Style="{StaticResource Sub}" Margin="0,16,0,6"/>
          <TextBox x:Name="PythonBox"/>
          <TextBlock Text="显卡测速目录（rocmbench）" Style="{StaticResource Sub}" Margin="0,16,0,6"/>
          <TextBox x:Name="BenchBox"/>
          <TextBlock Text="对弈服务端口" Style="{StaticResource Sub}" Margin="0,16,0,6"/>
          <TextBox x:Name="PortBox" Width="140" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="保存" Style="{StaticResource BtnPrimary}" Margin="0" Click="Save_Click"/>
            <TextBlock x:Name="Msg" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardBox}">
        <Grid>
          <StackPanel Margin="0,0,180,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="程序更新" Style="{StaticResource H2}"/>
              <Border x:Name="UpdBadge" Style="{StaticResource Badge}"><TextBlock x:Name="UpdBadgeText" Style="{StaticResource BadgeText}"/></Border>
            </StackPanel>
            <TextBlock x:Name="UpdInfo" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                       Text="源码同步到项目的 desktop\JunqiStudio 后，这里会显示“有新版本”。更新时重新编译，然后程序重启换上新版本；训练和对弈服务在后台照常运行，设置也会保留。"/>
          </StackPanel>
          <Button x:Name="UpdateBtn" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BtnPrimary}" Click="Update_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" Foreground="White"/><TextBlock x:Name="UpdBtnText" Text="立即更新" Foreground="White"/></StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="快捷入口" Style="{StaticResource H2}" Margin="0,0,0,12"/>
          <WrapPanel>
            <Button Content="项目目录" Style="{StaticResource BtnOutline}" Margin="0,0,8,0" Click="OpenProject_Click"/>
            <Button Content="训练输出 runs" Style="{StaticResource BtnOutline}" Margin="0,0,8,0" Click="OpenRuns_Click"/>
            <Button Content="操作手册" Style="{StaticResource BtnOutline}" Margin="0,0,8,0" Click="Manual_Click"/>
          </WrapPanel>
          <TextBlock x:Name="About" Style="{StaticResource Hint}" Margin="0,16,0,0" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
