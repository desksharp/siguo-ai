<UserControl x:Class="JunqiStudio.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,32,40,24">

      <Grid Margin="0,0,0,24">
        <StackPanel>
          <TextBlock Text="总览" Style="{StaticResource H1}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse x:Name="SumDot" Width="8" Height="8" Fill="{StaticResource Grey}" VerticalAlignment="Center"/>
            <TextBlock x:Name="SumText" Style="{StaticResource Sub}" Margin="8,0,0,0" Text="正在读取状态…"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource BtnOutline}" Click="Refresh_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="刷新"/></StackPanel>
          </Button>
          <Button Style="{StaticResource BtnPrimary}" Click="NewRun_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" Foreground="White"/><TextBlock Text="新建训练" Foreground="White"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 训练 -->
      <Border Style="{StaticResource CardBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,4,24,0">
            <Ellipse x:Name="TrRing" Fill="{StaticResource GreySoft}"/>
            <Ellipse x:Name="TrDot" Width="18" Height="18" Fill="{StaticResource Grey}"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="模型训练" Style="{StaticResource H2}"/>
              <Border x:Name="TrBadge" Style="{StaticResource Badge}"><TextBlock x:Name="TrBadgeText" Style="{StaticResource BadgeText}" Text="空闲"/></Border>
              <Border x:Name="TrBadge2" Style="{StaticResource Badge}" Visibility="Collapsed"><TextBlock x:Name="TrBadge2Text" Style="{StaticResource BadgeText}"/></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="TrName" Style="{StaticResource Link}" MouseLeftButtonUp="TrName_Click" Text="—"/>
              <TextBlock x:Name="TrMeta" Style="{StaticResource Sub}" Margin="14,1,0,0"/>
            </StackPanel>
            <Grid Margin="0,14,0,0" MaxWidth="620" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="TrProgress" Maximum="1" VerticalAlignment="Center"/>
              <TextBlock x:Name="TrProgressText" Grid.Column="1" Style="{StaticResource Sub}" Margin="14,0,0,0" FontWeight="SemiBold"/>
            </Grid>
            <TextBlock x:Name="TrSpeed" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="13"/>
            <StackPanel x:Name="TrMetrics" Orientation="Horizontal" Margin="0,14,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
            <Button x:Name="TrCurveBtn" Style="{StaticResource BtnSoft}" Click="TrCurve_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" Foreground="{StaticResource Primary}"/><TextBlock Text="查看曲线" Foreground="{StaticResource Primary}"/></StackPanel>
            </Button>
            <Button x:Name="TrStopBtn" Style="{StaticResource BtnOutline}" Click="TrStop_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="停止"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 对弈服务 -->
      <Border Style="{StaticResource CardBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,4,24,0">
            <Ellipse x:Name="PlRing" Fill="{StaticResource GreySoft}"/>
            <Ellipse x:Name="PlDot" Width="18" Height="18" Fill="{StaticResource Grey}"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="人机对弈" Style="{StaticResource H2}"/>
              <Border x:Name="PlBadge" Style="{StaticResource Badge}"><TextBlock x:Name="PlBadgeText" Style="{StaticResource BadgeText}" Text="已停止"/></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock x:Name="PlUrl" Style="{StaticResource Link}" MouseLeftButtonUp="PlOpen_Click" Text="http://127.0.0.1:8765"/>
              <TextBlock x:Name="PlMeta" Style="{StaticResource Sub}" Margin="14,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PlHint" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="13" Text="四国暗棋：你一家，另外三家由 AI 下。模型训练中保存新权重后，对弈里的神经网络 AI 会自动换上。"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
            <Button Style="{StaticResource BtnSoft}" Click="PlOpen_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0" Foreground="{StaticResource Primary}"/><TextBlock Text="打开" Foreground="{StaticResource Primary}"/></StackPanel>
            </Button>
            <Button x:Name="PlToggleBtn" Style="{StaticResource BtnOutline}" Click="PlToggle_Click">
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="PlToggleIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock x:Name="PlToggleText" Text="启动"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 显卡 -->
      <Border Style="{StaticResource CardBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,4,24,0">
            <Ellipse x:Name="GpRing" Fill="{StaticResource GreySoft}"/>
            <Ellipse x:Name="GpDot" Width="18" Height="18" Fill="{StaticResource Grey}"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="显卡" Style="{StaticResource H2}"/>
              <Border x:Name="GpBadge" Style="{StaticResource Badge}"><TextBlock x:Name="GpBadgeText" Style="{StaticResource BadgeText}" Text="检测中"/></Border>
            </StackPanel>
            <TextBlock x:Name="GpName" Style="{StaticResource Sub}" Margin="0,10,0,0" FontSize="14"/>
            <Grid Margin="0,14,0,0" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="占用" Style="{StaticResource Hint}" FontSize="13"/>
              <ProgressBar x:Name="GpUtil" Grid.Column="1" Maximum="100" VerticalAlignment="Center"/>
              <TextBlock x:Name="GpUtilText" Grid.Column="2" Style="{StaticResource Sub}" Margin="14,0,0,0"/>
              <TextBlock Grid.Row="1" Text="显存" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"/>
              <ProgressBar x:Name="GpMem" Grid.Row="1" Grid.Column="1" Maximum="1" VerticalAlignment="Center" Margin="0,10,0,0" Foreground="#8B5CF6"/>
              <TextBlock x:Name="GpMemText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Sub}" Margin="14,10,0,0"/>
            </Grid>
            <TextBlock x:Name="GpBench" Style="{StaticResource Hint}" Margin="0,12,0,0" FontSize="13"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
            <Button Style="{StaticResource BtnOutline}" Click="Bench_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="测速"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 自检 -->
      <Border Style="{StaticResource CardBox}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="64" Height="64" VerticalAlignment="Top" Margin="0,4,24,0">
            <Ellipse x:Name="CkRing" Fill="{StaticResource GreySoft}"/>
            <Ellipse x:Name="CkDot" Width="18" Height="18" Fill="{StaticResource Grey}"/>
          </Grid>
          <StackPanel Grid.Column="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="引擎自检" Style="{StaticResource H2}"/>
              <Border x:Name="CkBadge" Style="{StaticResource Badge}"><TextBlock x:Name="CkBadgeText" Style="{StaticResource BadgeText}" Text="未运行"/></Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" FontSize="14" Text="用 MSVC 重新编译 junqi.dll，然后跑引擎自测、规则回归测试、Python 测试（含信息泄漏测试）"/>
            <TextBlock x:Name="CkLast" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="13"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
            <Button Style="{StaticResource BtnOutline}" Click="Check_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Margin="0,2,8,0"/><TextBlock Text="运行自检"/></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
