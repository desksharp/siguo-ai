<Window x:Class="JunqiStudio.Pages.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="640" WindowStartupLocation="CenterOwner" Icon="/app.ico"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
  <DockPanel Margin="28,24">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Style="{StaticResource H2}"/>
          <Border x:Name="StateBadge" Style="{StaticResource Badge}"><TextBlock x:Name="StateText" Style="{StaticResource BadgeText}"/></Border>
        </StackPanel>
        <TextBlock x:Name="SubText" Style="{StaticResource Sub}" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ActionBtn" Style="{StaticResource BtnPrimary}" Visibility="Collapsed" Click="Action_Click"/>
      <Button x:Name="StopBtn" Content="停止" Style="{StaticResource BtnDanger}" Click="Stop_Click"/>
      <Button Content="关闭" Style="{StaticResource BtnOutline}" Click="Close_Click"/>
    </StackPanel>
    <TextBox x:Name="Out" Style="{StaticResource ConsoleBox}"/>
  </DockPanel>
</Window>
