<Window x:Class="JunqiStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="军棋 AI 工作台" Width="1320" Height="860" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左侧导航 -->
    <Border Background="{StaticResource Nav}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,0,28">
          <Image Source="app.ico" Width="34" Height="34"/>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="军棋 AI 工作台" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Junqi Studio" Style="{StaticResource Hint}"/>
          </StackPanel>
        </StackPanel>

        <Border x:Name="UpdatePill" DockPanel.Dock="Top" Margin="16,-12,16,18" Padding="12,8" CornerRadius="10"
                Background="{StaticResource AmberSoft}" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="UpdatePill_Click"
                ToolTip="项目里的工作台源码比当前程序新，点击重新编译并更新">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Amber}" Margin="0,2,8,0"/>
            <TextBlock x:Name="UpdatePillText" Text="有新版本 · 点此更新" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="13"/>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="14,12" CornerRadius="12" Background="{StaticResource Bg}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="GpuDot" Width="8" Height="8" Fill="{StaticResource Grey}" VerticalAlignment="Center"/>
              <TextBlock x:Name="GpuNameText" Text="检测显卡…" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            </StackPanel>
            <TextBlock x:Name="GpuLoadText" Text="" Style="{StaticResource Hint}" Margin="16,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel>
          <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="总览" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavTraining" Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="训练" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavPlay" Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="对弈" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavData" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="数据" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="设置" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Host" Grid.Column="1"/>
  </Grid>
</Window>
